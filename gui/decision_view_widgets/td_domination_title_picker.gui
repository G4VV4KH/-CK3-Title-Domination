vbox = {
    name = "td_domination_title_picker"
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    scrollbox = {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        size = { 545 220 }
        blockoverride "scrollbox_content" {
            vbox = {
                spacing = 4
                datamodel = "[DecisionViewWidgetSelectScopeObject.GetEntries]"
                item = {
                    button_standard = {
                        size = { 480 48 }
                        onclick = "[DecisionViewWidgetSelectScopeObject.OnSelect(SelectScopeObjectEntry.Self)]"
                        enabled = "[SelectScopeObjectEntry.IsEnabled]"
                        down = "[SelectScopeObjectEntry.IsSelected]"
                        tooltip = "[SelectScopeObjectEntry.GetTooltip]"
                        hbox = {
                            datacontext = "[SelectScopeObjectEntry.GetScopeObject.Title]"
                            margin_left = 10
                            spacing = 8
                            widget = {
                                size = { 38 38 }
                                alwaystransparent = yes
                                coa_title_tiny = { blockoverride "position" { position = { 0 0 } } }
                            }
                            text_single = {
                                text = "[Title.GetNameNoTooltip]"
                                max_width = 405
                                align = left
                            }
                            expand = {}
                        }
                    }
                }
            }
        }
        blockoverride "scrollbox_background_fade" {}
    }
}
